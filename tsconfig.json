{
    "compilerOptions": {
        "baseUrl": ".",
        "module": "ESNext",
        "target": "ES2018",
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": false,
        "lib": ["DOM", "ES2022"]
    },
    "include": ["src/**/*.ts", "src/**/*.js", "tests/**/*.js", "vaultharness/**/*.js", "*.mjs"]
}
